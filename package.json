{
  "name": "playwright-qa-mini-framework",
  "version": "1.0.0",
  "description": "Maintainable Playwright and TypeScript QA automation framework",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --grep-invert @visual",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:network": "playwright test --project=chromium --grep @network",
    "test:accessibility": "playwright test --project=chromium --grep @accessibility",
    "test:visual": "playwright test --grep @visual",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run format:check"
  },
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.1",
    "eslint-plugin-playwright": "^2.4.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "zod": "^4.3.6"
  }
}
